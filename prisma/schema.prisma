generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Pizza {
  id           Int    @id @default(autoincrement())
  nazwa        String
  cena_mala    Float
  cena_srednia Float
  cena_duza    Float
  skladniki    PizzaSkladnik[]

  @@map("menu_pizza")
}

model Skladnik {
  id    Int             @id @default(autoincrement())
  nazwa String
  pizze PizzaSkladnik[]

  @@map("skladniki")
}

model PizzaSkladnik {
  id_pizza    Int
  id_skladnik Int
  pizza       Pizza    @relation(fields: [id_pizza], references: [id])
  skladnik    Skladnik @relation(fields: [id_skladnik], references: [id])

  @@id([id_pizza, id_skladnik])
  @@map("relacja_skladniki")
}

model Napoj {
  id    Int    @id @default(autoincrement())
  nazwa String
  cena  Float

  @@map("napoje")
}

model Dzielnica {
  id              Int     @id @default(autoincrement())
  cena_dzielnica  Float
  ulice           Ulica[]

  @@map("dzielnice")
}

model Ulica {
  id              Int        @id @default(autoincrement())
  miejscowosc     String?    @db.Text
  ulica           String?    @db.Text
  numer           String?    @db.Text
  x               String?    @db.Text
  y               String?    @db.Text
  id_dzielnica    Int?
  dzielnica_nazwa String?    @db.Text
  dzielnica       Dzielnica? @relation(fields: [id_dzielnica], references: [id])

  @@map("ulice")
}

model PozycjaExtra {
  id    Int    @id @default(autoincrement())
  nazwa String
  cena  Float

  @@map("pozycje_extra")
}

model Zamowienie {
  id              Int      @id @default(autoincrement())
  telefon         String?  @db.Text
  adres           String?  @db.Text
  pizze           String?  @db.Text
  sosy            String?  @db.Text
  napoj           String?  @db.Text
  pozycje_extra   String?  @db.Text
  platnosc        String?  @db.Text
  cena_calkowita  Float?
  created_at      DateTime? @db.DateTime(0)
  is_kupony       Int?
  typ_zamowienia  String?  @db.Text
  skladniki       String?  @db.Text

  @@map("zamowienia")
}
